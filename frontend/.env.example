# Frontend build-time configuration.
# Vite inlines these into the bundle at build time, so changing them
# requires a rebuild (not just a restart).

# Base URL of the backend API (no trailing slash). For local dev the Vite
# proxy in vite.config.ts handles /api/* without this var being set.
# For production builds this MUST be set or the build will fail.
VITE_API_URL=https://api.stepageddon.example.com
