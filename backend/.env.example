# Deployment environment: "development" or "production".
# In "production": auto-reload is off, /docs and /redoc are hidden, and
# exception detail is stripped from 500 responses.
ENV=development

# === ML MODEL ===
# Path to the trained step-chart model checkpoint
ML_MODEL_PATH=./ml/checkpoints/best_model.pt

# Spotify API (optional, for Spotify URL support)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Storage
# STORAGE_BACKEND selects the backend (see backend/services/storage/).
#   "local" — reads/writes AUDIO_STORAGE_PATH on the local filesystem.
#   "s3"    — S3-compatible object storage (Cloudflare R2, AWS S3, MinIO).
STORAGE_BACKEND=local
AUDIO_STORAGE_PATH=~/Desktop/ddr/stepageddon-data/audio
MAX_FILE_SIZE_MB=50
MAX_DURATION_SECONDS=600

# S3-compatible storage (used when STORAGE_BACKEND=s3).
# For Cloudflare R2:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY come from an R2 API token.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://stepageddon:stepageddon@localhost:5432/stepageddon
